{
  "name": "word-trail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Video listening, guided reading and delayed recall for families",
  "scripts": {
    "build": "node scripts/build-catalog.mjs && node scripts/build-examples.mjs",
    "package:hosting": "npm run build && node scripts/package-hosting.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": { "node": ">=20" }
}
